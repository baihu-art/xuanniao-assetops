# 玄鸟 AssetOps 环境变量配置模板
# 复制此文件为 .env 并填入实际值

# 复制为 .env 后填写真实值
ASSETOPS_DATA_ROOT=./data
ASSETOPS_SCOPE_FILE=./scope.json

FOFA_EMAIL=your_email@example.com
FOFA_KEY=your_fofa_api_key


QUAKE_TOKEN=your_quake_token
HUNTER_KEY=your_hunter_api_key
SHODAN_KEY=your_shodan_api_key

# 被动 JSON Provider：默认禁用，显式设置可替换 endpoint；离线测试不使用真实 API。
# PASSIVE_DNS: DoH 风格 GET name/type；CT: crt.sh 风格 GET q/output。
# WHOIS: GET domainName/outputFormat；ASN: GET ip。
# KEY 以 Authorization: Bearer 发送；DNS/CT key 可选，Whois/ASN 必填。
PASSIVE_DNS_ENDPOINT=
PASSIVE_DNS_KEY=
CT_ENDPOINT=
CT_KEY=
WHOIS_ENDPOINT=
WHOIS_KEY=
ASN_ENDPOINT=
ASN_KEY=

ASSETOPS_TIMEOUT=30
ASSETOPS_RATE_LIMIT=5
ASSETOPS_BUDGET_MAX=10000
ASSETOPS_INSECURE_TLS=0

# 主动 httpx 探活默认关闭；必须显式配置绝对路径后从 CLI/MCP 入口执行
ASSETOPS_HTTPX_ENABLED=0
ASSETOPS_HTTPX_PATH=
ASSETOPS_HTTPX_MAX_TARGETS=100
ASSETOPS_HTTPX_OUTPUT_LIMIT=100

# 主动模块开关：默认关闭，需要显式改为 1 才会执行
ASSETOPS_HOST_COLLISION_ENABLED=0
ASSETOPS_SUBDOMAIN_BRUTE_ENABLED=0

# 主动模块限额：必须为正，且实际用量不得超过 Run 的剩余主动预算
ASSETOPS_ACTIVE_RATE_LIMIT=2
ASSETOPS_ACTIVE_MAX_REQUESTS=100
ASSETOPS_ACTIVE_TIMEOUT=10
ASSETOPS_ACTIVE_MAX_RESPONSE_BYTES=262144